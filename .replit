modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["ffmpeg", "jq", "lsof"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Test Thumbnail System"
author = 41952596
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node test-thumbnails.js"

[[workflows.workflow]]
name = "Test Cloudinary"
author = 41952596
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Test Cloudinary"
